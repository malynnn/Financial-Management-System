generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  TREASURER
  AUDITOR
  MEMBER
}

enum PaymentMethod {
  CASH
  GCASH
  BANK_TRANSFER
  CHECK
  OTHER
}

enum CollectionStatus {
  PENDING
  FOR_VERIFICATION
  VALIDATED
  POSTED
  REJECTED
  VERIFIED
}

// ─────────────────────────────────────────
// USER / AUTH
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collections   Collection[]
  obligations   FinancialObligation[]
  disbursements Disbursement[]
  fundTransfers FundTransfer[]
}

// ─────────────────────────────────────────
// FINANCIAL OBLIGATION (CPS-006, CPS-008)
// ─────────────────────────────────────────

model FinancialObligation {
  id                 String                  @id @default(cuid())
  memberId           String
  obligationType     String                  // e.g. "Annual Dues", "Emergency Loan"
  originalAmount     Decimal                 @db.Decimal(12, 2)
  outstandingBalance Decimal                 @db.Decimal(12, 2)
  dueDate            DateTime?
  status             String                  @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  member             User                    @relation(fields: [memberId], references: [id])
  applications       CollectionApplication[]
}

// ─────────────────────────────────────────
// COLLECTION (CPS-001 through CPS-008)
// ─────────────────────────────────────────

model Collection {
  id                 String           @id @default(cuid())

  // CPS-007: Unique Collection Reference Number
  collectionRefNo    String?          @unique

  // CPS-001: Required payment details
  memberId           String
  paymentAmount      Decimal          @db.Decimal(12, 2)
  paymentDate        DateTime
  paymentMethod      PaymentMethod
  paymentReference   String

  // Optional notes
  description        String?

  // Status (CPS-003, CPS-004, CPS-008)
  status             CollectionStatus @default(PENDING)

  // Rejection note
  rejectReason       String?

  // CPS-002: Proof of payment file
  proofOfPaymentPath String?
  proofOfPaymentName String?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  member             User                    @relation(fields: [memberId], references: [id])
  application        CollectionApplication?
  auditTrail         CollectionAuditLog[]
}

// ─────────────────────────────────────────
// PAYMENT APPLICATION (CPS-008)
// ─────────────────────────────────────────

model CollectionApplication {
  id               String               @id @default(cuid())
  collectionId     String               @unique
  obligationId     String?
  originalBalance  Decimal              @db.Decimal(12, 2)
  appliedAmount    Decimal              @db.Decimal(12, 2)
  remainingBalance Decimal              @db.Decimal(12, 2)
  exceptionStatus  String               // "Exact Match" | "Partial Payment" | "Overpayment" | "Unapplied"
  appliedAt        DateTime             @default(now())

  collection       Collection           @relation(fields: [collectionId], references: [id])
  obligation       FinancialObligation? @relation(fields: [obligationId], references: [id])
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model CollectionAuditLog {
  id           String     @id @default(cuid())
  collectionId String
  action       String
  actor        String     @default("Treasurer")
  role         String     @default("Treasurer")
  timestamp    DateTime   @default(now())
  details      String

  collection   Collection @relation(fields: [collectionId], references: [id])
}

// ─────────────────────────────────────────
// DISBURSEMENT
// ─────────────────────────────────────────

model Disbursement {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  disbursedById String
  disbursedBy   User   @relation(fields: [disbursedById], references: [id])
}

// ─────────────────────────────────────────
// FUND TRANSFER
// ─────────────────────────────────────────

model FundTransfer {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  fromAccount String
  toAccount   String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transferredById String
  transferredBy   User   @relation(fields: [transferredById], references: [id])
}